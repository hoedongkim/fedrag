# FedRAG backend settings.
# Copy this file to backend/.env and edit it; .env is git-ignored. Every setting is optional and
# falls back to the default shown. Real environment variables take precedence over this file.
# Settings are read at startup: restart `make dev` after editing this file (auto-reload only
# watches backend/app).

# OpenAI API key, for answers (POST /api/ask and /api/ask/stream, make ask), for embedding
# chunks (make index), for the LLM stance classifiers (make stance-benchmark, make stance) and for
# new statement-comparison analyses (POST /api/compare with analysis="generate",
# make compare-precompute). Leave it empty to run without an LLM: /api/health then reports
# llm_configured=false and POST /api/ask and /api/ask/stream return 503; POST /api/compare still
# returns the diff and any stored analysis (analysis_status llm_not_configured otherwise). A make
# index run with nothing new to embed does not need it.
OPENAI_API_KEY=

# Neon Postgres connection string. Leave it commented out to run without a database; /api/meetings,
# /api/stance* and /api/compare then return 503, make stance's load step and the make compare-*
# targets fail, and /api/health reports database_configured=false. Copy it from Neon Console >
# your project > Connect, with sslmode=require. The pooled endpoint (host ends in -pooler) suits the
# API; the direct endpoint works too. FedRAG keeps its tables in their own Postgres schema,
# "fedrag", which `make db-load` creates automatically, so it can share a database with other
# projects. For a local Postgres instead, run `make db-up` and use the DATABASE_URL it prints.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Chat model used to generate answers and analyses. A dated snapshot, so evaluation runs are
# comparable; a moving alias such as gpt-5.4-mini works too. Also the stance classifier model:
# changing it misses the data/stance/cache entries (a fresh run is about $0.92), and the stance
# budget check refuses models without a known price (app/stance/llm.py PRICES). Stored comparison
# analyses are keyed by model too, so changing it shows none until they are written again (make
# compare-precompute, about $0.45 for the 96 consecutive pairs).
LLM_MODEL=gpt-5.4-mini-2026-03-17

# Embedding model used to index FOMC documents for dense retrieval. The index records the model it
# was built with: after changing it, rebuild with make index INDEX_ARGS=--rebuild (dense search
# and /api/ask report the index as not built until then).
EMBEDDING_MODEL=text-embedding-3-small

# Hugging Face cross-encoder that reranks hybrid retrieval candidates (retrieval=hybrid_rerank).
# Downloaded once on first use (about 90 MB, into the Hugging Face cache) and then loaded from it.
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Hugging Face commit of RERANKER_MODEL; change both together. Pinned, so a fresh download scores
# like the copy the smoke check ran with.
RERANKER_REVISION=233902d25c440f23af6f7d6e94d2946bac0bee0a

# Retriever preset for Ask the Fed (POST /api/ask and /api/ask/stream), make ask and make smoke:
# tuned (the default since Phase 7: date, year, recency and statement priors, chosen on the DEV
# questions and switched to by the pre-registered TEST rule, docs/rag-tuning.md) or phase3 (the
# Phase 3 retriever). Presets live in backend/app/rag/retriever_presets.json; an unknown
# name stops the API at startup.
RETRIEVER_PRESET=tuned

# Runtime environment: development, test or production.
ENVIRONMENT=development

# Browser origins allowed to call the API directly, as a JSON list. The Next.js dev server proxies
# /api to the backend, so this only matters when a browser calls the backend URL itself.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Load the BM25 index and the reranker model in a background thread when the API starts, so the
# first Ask the Fed question with retrieval=hybrid_rerank is not about 5 seconds slower than the
# rest. It never delays startup, and is skipped while the index is not built or PUBLIC_DEMO is on.
WARMUP=true

# The public demo: turn every feature that would call OpenAI off, so the API runs without
# OPENAI_API_KEY and costs nothing (the Vercel function, api/index.py, always sets
# PUBLIC_DEMO=true; the Hugging Face Space image defaults to it). POST /api/ask and /api/ask/stream
# then return 403 and GET /api/ask/examples serves recorded answers instead; POST /api/compare
# serves stored analyses only (analysis_status disabled_on_demo otherwise); startup loads no
# search index, vector store or reranker; /api/health reports demo_mode=true.
# Meetings, stance, stored comparisons and the evaluation work as usual.
PUBLIC_DEMO=false

# Where FOMC documents, the Chroma vector store and the chunk index (chunks.jsonl, manifest.json)
# live. Relative paths resolve against the repo root, so these defaults point at fedrag/data,
# fedrag/data/chroma and fedrag/data/index.
# DATA_DIR=data
# CHROMA_DIR=data/chroma
# INDEX_DIR=data/index
