# Copy to .env.local (git-ignored) and adjust if needed.

# Base URL of the FastAPI backend: no trailing slash, no /api suffix.
#  - next.config.ts rewrites browser requests for /api/* to this URL. It is read
#    when the config loads (`next dev` start or `next build`), so restart the dev
#    server or rebuild after changing it.
#  - Server components call this URL directly at request time.
# Use 127.0.0.1 rather than localhost: Node may resolve localhost to ::1 while
# uvicorn binds IPv4 only.
BACKEND_URL=http://127.0.0.1:8000

# Optional. Whether the backend may need a moment to start (a hosted one: the public demo's Vercel
# function after a quiet spell, or a Hugging Face Space that sleeps when idle): pages then wait
# for it, with a "Waking the demo server" notice, instead of showing an error. Defaults to true
# for any BACKEND_URL that is not local; leave it unset on Vercel. Read at build time (`next dev`
# start or `next build`).
# BACKEND_MAY_SLEEP=false

# Optional. The site's public origin, for absolute link-preview (Open Graph) URLs. On Vercel the
# production domain is used when this is not set.
# SITE_URL=https://fedrag.vercel.app
